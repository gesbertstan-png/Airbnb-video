---
/** Petites icônes au trait fin, décoratives par défaut (aria-hidden). */
interface Props {
  name: 'arrow' | 'arrow-up-right' | 'phone' | 'pin' | 'clock' | 'star' | 'calendar' | 'close' | 'check' | 'instagram' | 'sparkle';
  class?: string;
  title?: string;
}

const { name, class: className, title } = Astro.props;

const paths: Record<Props['name'], string> = {
  arrow: '<path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8.5 7H17v8.5"/>',
  phone:
    '<path d="M6.6 3.8 9 3.3l1.6 4-2 1.3a11.5 11.5 0 0 0 6.1 6.1l1.3-2 4 1.6-.5 2.4a2 2 0 0 1-2.1 1.6C10.3 17.9 6.1 13.7 5 6a2 2 0 0 1 1.6-2.2Z"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  star: '<path d="m12 3.6 2.5 5.3 5.8.7-4.3 4 1.1 5.7L12 16.5l-5.1 2.8L8 13.6l-4.3-4 5.8-.7L12 3.6Z"/>',
  calendar: '<rect x="4" y="5.5" width="16" height="14.5" rx="2"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  instagram: '<rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><circle cx="16.9" cy="7.1" r=".6" fill="currentColor"/>',
  sparkle: '<path d="M12 3.5c.6 4.4 2.6 6.9 7.5 8.5-4.9 1.6-6.9 4.1-7.5 8.5-.6-4.4-2.6-6.9-7.5-8.5 4.9-1.6 6.9-4.1 7.5-8.5Z"/>',
};
const filled = name === 'star';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  focusable="false"
>
  {title && <title>{title}</title>}
  <Fragment set:html={paths[name]} />
</svg>
