---
/**
 * Données structurées schema.org (JSON-LD) : aident Google à comprendre
 * qu'il s'agit d'un institut de beauté / salon d'ongles à Neuilly-sur-Seine.
 * La note Google n'y figure pas volontairement (les avis tiers ne doivent pas
 * être balisés sur le site de l'établissement, selon les consignes de Google).
 */
import { site, links } from '../config/site';
import { services } from '../data/services-list';
import ogImage from '../assets/photos/institut-maison-malki.jpg';
import { getImage } from 'astro:assets';

const siteUrl = new URL('/', Astro.site).href;
const photo = await getImage({ src: ogImage, format: 'jpg', width: 1179 });

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['BeautySalon', 'NailSalon'],
      '@id': `${siteUrl}#institut`,
      name: site.name,
      alternateName: site.brand,
      description:
        'Institut de beauté et salon d’ongles à Neuilly-sur-Seine : manucure russe, baby boomer, pose couleur et électrolyse.',
      url: siteUrl,
      telephone: site.phone.e164,
      ...(site.email ? { email: site.email } : {}),
      image: [new URL('/og-image.jpg', Astro.site).href, new URL(photo.src, Astro.site).href],
      logo: new URL('/icon-512.png', Astro.site).href,
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.street,
        postalCode: site.address.postalCode,
        addressLocality: site.address.city,
        addressRegion: site.address.region,
        addressCountry: site.address.country,
      },
      hasMap: links.googleMaps,
      areaServed: { '@type': 'City', name: site.address.city },
      ...(site.openingHours.length
        ? {
            openingHoursSpecification: site.openingHours.map((slot) => ({
              '@type': 'OpeningHoursSpecification',
              dayOfWeek: slot.days.map((d) => `https://schema.org/${d}`),
              opens: slot.opens,
              closes: slot.closes,
            })),
          }
        : {}),
      ...(site.socials.length ? { sameAs: site.socials.map((s) => s.url) } : {}),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Prestations',
        itemListElement: services.map((service) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: service.title,
            description: service.description,
            category: service.category,
          },
        })),
      },
      ...(site.bookingUrl
        ? {
            potentialAction: {
              '@type': 'ReserveAction',
              target: { '@type': 'EntryPoint', urlTemplate: site.bookingUrl },
            },
          }
        : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#site`,
      url: siteUrl,
      name: site.name,
      inLanguage: site.lang,
      publisher: { '@id': `${siteUrl}#institut` },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
