---
import BookingButton from './BookingButton.astro';
import { site, links, nav } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <p class="site-footer__brand" aria-hidden="true">
        Maison Malki
        <span>Neuilly</span>
      </p>
      <div class="site-footer__cta">
        <p>Un moment pour vous, tout en douceur.</p>
        <BookingButton location="footer" />
      </div>
    </div>

    <div class="site-footer__cols">
      <div>
        <h2 class="site-footer__title">L’institut</h2>
        <address>
          {site.address.street}<br />
          {site.address.postalCode} {site.address.city}
        </address>
        <p><a href={site.phone.href}>{site.phone.display}</a></p>
      </div>

      <nav aria-label="Plan du site">
        <h2 class="site-footer__title">Découvrir</h2>
        <ul>
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="/#rendez-vous">Rendez-vous</a></li>
        </ul>
      </nav>

      <nav aria-label="Informations légales">
        <h2 class="site-footer__title">Informations</h2>
        <ul>
          <li><a href="/mentions-legales">Mentions légales</a></li>
          <li><a href="/politique-de-confidentialite">Politique de confidentialité</a></li>
          <li><a href="/cgu">Conditions générales d’utilisation</a></li>
          <li><button type="button" class="site-footer__link" data-open-consent>Gestion des cookies</button></li>
        </ul>
      </nav>

      <div>
        <h2 class="site-footer__title">Nous suivre</h2>
        {site.socials.length > 0 ? (
          <ul>
            {site.socials.map((social) => (
              <li><a href={social.url} target="_blank" rel="noopener me">{social.label}</a></li>
            ))}
          </ul>
        ) : (
          <p>
            <a href={links.googleMaps} target="_blank" rel="noopener">Notre fiche Google</a>
          </p>
        )}
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site.name} — {site.tagline}</p>
      <a href="#top" class="site-footer__top-link">Haut de page ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: clamp(4rem, 3rem + 4vw, 7rem) 0 calc(2rem + env(safe-area-inset-bottom));
    background: var(--ivory);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }

  .site-footer__top {
    display: grid;
    gap: 2rem;
    padding-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .site-footer__brand {
    display: grid;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 1.6rem + 5vw, 5.5rem);
    font-weight: 300;
    letter-spacing: 0.12em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .site-footer__brand span {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.7em;
    color: var(--rose-ink);
  }

  .site-footer__cta {
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    align-content: end;
  }

  .site-footer__cta p {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: italic;
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2.2rem;
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .site-footer__title {
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rose-ink);
  }

  .site-footer address {
    font-style: normal;
    margin-bottom: 0.6rem;
  }

  .site-footer ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a,
  .site-footer__link {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }

  .site-footer__link {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }

  .site-footer a:hover,
  .site-footer__link:hover {
    color: var(--bordeaux);
    text-decoration: underline;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
    color: var(--taupe-ink);
  }

  @media (min-width: 900px) {
    .site-footer__top {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .site-footer__cta {
      justify-items: end;
      text-align: right;
    }
  }

  @media (max-width: 767px) {
    .site-footer {
      padding-bottom: calc(6.5rem + env(safe-area-inset-bottom));
    }
  }
</style>
