---
import { site } from '../config/site';

export interface SeoProps {
  title: string;
  description: string;
  /** Chemin de l'image de partage (dans /public) */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  image = '/og-image.jpg',
  imageAlt = 'Maison Malki Neuilly — institut de beauté et salon d’ongles à Neuilly-sur-Seine',
  noindex = false,
  type = 'website',
} = Astro.props as SeoProps;

// URL propre, sans extension (le build génère des fichiers .html, servis sans extension)
const cleanPath = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

<!-- Partage sur les réseaux sociaux (Open Graph / Twitter) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Référencement local -->
<meta name="geo.region" content="FR-92" />
<meta name="geo.placename" content={site.address.city} />
