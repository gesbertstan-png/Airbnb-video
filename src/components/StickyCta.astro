---
/**
 * Barre d'action fixe sur mobile : visible après le hero,
 * masquée lorsque la section rendez-vous est à l'écran.
 */
import BookingButton from './BookingButton.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';
---

<div class="sticky-cta" data-sticky-cta inert>
  <a class="sticky-cta__phone" href={site.phone.href} aria-label={`Appeler l’institut au ${site.phone.display}`}>
    <Icon name="phone" />
  </a>
  <BookingButton class="sticky-cta__button" location="sticky-mobile" />
</div>

<style>
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    gap: 0.6rem;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
    background: rgb(255 252 248 / 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--line);
    transform: translateY(110%);
    transition: transform 0.6s var(--ease-out);
  }

  .sticky-cta.is-visible {
    transform: none;
  }

  .sticky-cta__phone {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.35rem;
    height: 3.35rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--bordeaux);
  }

  .sticky-cta__phone :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .sticky-cta :global(.sticky-cta__button) {
    flex: 1;
  }

  @media (min-width: 768px) {
    .sticky-cta {
      display: none;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.querySelector('.hero');
  const zonesToAvoid = [document.querySelector('[data-booking-section]'), document.querySelector('.site-footer')];

  if (bar) {
    let pastHero = !hero;
    const visibleZones = new Set<Element>();

    const update = () => {
      const visible = pastHero && visibleZones.size === 0;
      bar.classList.toggle('is-visible', visible);
      bar.inert = !visible;
    };

    if (hero) {
      new IntersectionObserver(([entry]) => {
        pastHero = !entry.isIntersecting;
        update();
      }).observe(hero);
    }

    const zoneObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) =>
        entry.isIntersecting ? visibleZones.add(entry.target) : visibleZones.delete(entry.target),
      );
      update();
    });
    zonesToAvoid.forEach((el) => el && zoneObserver.observe(el));
    update();
  }
</script>
