# Adresse publique du site (URL canoniques, sitemap, images de partage).
# Inutile sur Vercel : le domaine de production est détecté automatiquement.
SITE_URL=https://www.votre-domaine.fr

# Mesure d'audience Google Analytics 4 (facultatif) — chargée uniquement après consentement.
# Laisser vide pour désactiver l'analytics (la bannière cookies ne s'affiche alors pas).
PUBLIC_GA_MEASUREMENT_ID=

# Envoi des demandes de rendez-vous par e-mail (secrets : côté serveur uniquement)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Adresse qui reçoit les demandes
CONTACT_TO_EMAIL=
# Adresse d'expédition (par défaut : SMTP_USER)
CONTACT_FROM_EMAIL=

# Serveur Node (hors Vercel)
PORT=8080
HOST=0.0.0.0
# Redirige automatiquement HTTP -> HTTPS (derrière un proxy qui transmet X-Forwarded-Proto)
FORCE_HTTPS=true
